graph TD
    %% EventEase High-Level Architecture (Figure 1 in SRS)
    subgraph UI_Navigation ["Flutter Mobile App (UI + Navigation)"]
        A1["Attendee Screens (Home, Discover, Details, QR Pass)"]
        A2["Organizer Screens (Dashboard, Create Event, Scanner)"]
        A3["Admin Screens (Approvals, User & Event Management)"]
        A4["Shared Screens (About Us, Contact Us, Gallery)"]
    end

    subgraph State_Management ["Presentation / State Management Layer"]
        SM["ChangeNotifier Providers (AuthProvider, EventProvider, RegistrationProvider, AttendanceProvider, AdminProvider, NotificationProvider)"]
    end

    subgraph Repositories_Services ["Repositories & Platform Services Layer"]
        RS["Data Repositories & Services (Atomic Concurrency Transactions, QR Crypto Verification, Local Cache)"]
    end

    subgraph Cloud_Backend ["Firebase Serverless Cloud Backend"]
        FA["Firebase Authentication (User Identity & Role Access)"]
        CF[("Cloud Firestore (Events, Users, Registrations, Attendance, Feedback)")]
        CS["Cloud Storage (Event Banners & Gallery Media)"]
        CM["Cloud Messaging (Push Notifications & Event Reminders)"]
    end

    subgraph Operations ["Admin & Organizer Operations"]
        OPS["Event Approval Queue, Camera Scanner Verification, Content Moderation & Analytics"]
    end

    UI_Navigation --> State_Management
    State_Management --> Repositories_Services
    Repositories_Services --> FA
    Repositories_Services --> CF
    Repositories_Services --> CS
    Repositories_Services --> CM
    CF --> Operations
    Operations --> Repositories_Services
