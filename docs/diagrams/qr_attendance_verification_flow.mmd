sequenceDiagram
    %% QR Attendance Verification & Anti-Duplicate Check-In Sequence Diagram
    autonumber
    actor Organizer as Event Host
    participant Scanner as MobileScanner Viewport
    participant AttProvider as AttendanceProvider
    participant AttRepo as AttendanceRepository
    participant Firestore as Cloud Firestore

    Organizer->>Scanner: Point viewfinder at Attendee QR Pass
    Scanner->>AttProvider: OnBarcodeDetect(qrPayload)
    AttProvider->>Scanner: Pause camera scanning
    AttProvider->>AttRepo: checkInByQrCode(qrPayload, eventId, organizerId)
    
    activate AttRepo
    AttRepo->>Firestore: Query /registrations where qrCode == qrPayload
    Firestore-->>AttRepo: Registration document snapshot
    
    alt QR Payload not found OR Event ID mismatch
        AttRepo-->>AttProvider: Invalid Pass (Event Mismatch Error)
    else Registration is in 'cancelled' state
        AttRepo-->>AttProvider: Invalid Pass (Cancelled Registration Error)
    else Active Valid Registration Found
        AttRepo->>Firestore: Query /attendance where registrationId == regId
        Firestore-->>AttRepo: Attendance check records
        
        alt Already Checked In (attended == true)
            AttRepo-->>AttProvider: DUPLICATE REJECTION (Already checked in earlier)
        else First-Time Scan (Idempotent Check-In)
            AttRepo->>Firestore: Write new AttendanceModel record in /attendance
            AttRepo-->>AttProvider: CHECK-IN SUCCESS (Attended confirmed)
        end
    end
    deactivate AttRepo
    
    AttProvider->>Organizer: Present Result Bottom Sheet (Success / Duplicate Warning / Error)
    Organizer->>Scanner: Tap "Scan Next Pass" -> Resume camera viewfinder
