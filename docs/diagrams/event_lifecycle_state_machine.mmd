stateDiagram-v2
    %% EventEase Event Lifecycle State Machine Diagram
    [*] --> PendingApproval: Organizer Submits Event

    state PendingApproval {
        [*] --> InReview
        InReview --> AdminApproved: Admin Validates & Approves
        InReview --> AdminRejected: Admin Rejects (with mandatory reason)
    }

    AdminRejected --> [*]: Host notified with justification
    
    AdminApproved --> Approved: Published to Discover Feed

    state Approved {
        [*] --> OpenForRegistration: registeredCount < maxParticipants
        OpenForRegistration --> Full: registeredCount == maxParticipants
        Full --> OpenForRegistration: Attendee Cancels Spot
    }

    Approved --> Cancelled: Host or Admin Cancels (Broadcast alert sent)
    Cancelled --> [*]

    Approved --> Completed: Event Date Elapsed (isCompleted == true)

    state Completed {
        [*] --> FeedbackWindowOpen: Attendees leave 1-5 star review
        FeedbackWindowOpen --> GalleryUpload: Host uploads event photos
    }

    Completed --> [*]: Archived in System Reports
